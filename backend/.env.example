# =============================================
# BACKEND ENV VARS — salin file ini jadi .env
# Untuk Railway: isi di Settings → Variables
# =============================================

# MongoDB Atlas URI (buat akun gratis di https://cloud.mongodb.com)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/pickarya?retryWrites=true&w=majority

# JWT Secret — buat string random yang panjang dan aman
JWT_SECRET=ganti_dengan_string_random_yang_panjang_dan_aman

# Port server (Railway akan override ini otomatis)
PORT=5000

# Google OAuth Client ID (ambil dari Google Cloud Console)
# Sudah dikonfigurasi: 766370868301-me5ph1er4qqg86mh9h2p9q1i8haumsor.apps.googleusercontent.com
GOOGLE_CLIENT_ID=766370868301-me5ph1er4qqg86mh9h2p9q1i8haumsor.apps.googleusercontent.com

# CORS — URL frontend Vercel kamu (setelah deploy)
# Contoh: https://pickarya.vercel.app
# Bisa beberapa URL dipisah koma: https://pickarya.vercel.app,https://www.pickarya.com
ALLOWED_ORIGIN=https://NAMA_PROJECTMU.vercel.app

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_password_admin_yang_aman
